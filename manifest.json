{
  "pluginApiVersion": 1,
  "id": "salvage-plugin-imdb",
  "name": "IMDb",
  "version": "0.2.1",
  "runtime": { "entry": "dist/plugin.js" },
  "provides": [
    {
      "data": "link-preview",
      "command": "preview",
      "when": { "link.host": ["imdb.com", "m.imdb.com"] },
      "timeoutMs": 12000,
      "settings": []
    }
  ],
  "contributes": [
    {
      "id": "episodes",
      "slot": "entry.detail.link.action",
      "when": { "link.host": ["imdb.com", "m.imdb.com"] },
      "ui": { "kind": "button", "label": "Episodes", "icon": "list" },
      "view": "episodes",
      "command": "episodes",
      "timeoutMs": 30000
    }
  ],
  "settings": []
}
